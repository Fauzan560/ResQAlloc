# ===========================================
# ResQAlloc Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/resqalloc

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=24h

# ML Service
ML_SERVICE_URL=http://localhost:5001

# OSRM (Open Source Routing Machine)
# Public demo server - for academic/demo use only
# For production, host your own OSRM instance
OSRM_BASE_URL=https://router.project-osrm.org

# Admin seed credentials (used by seed script)
ADMIN_EMAIL=admin@resqalloc.demo
ADMIN_PASSWORD=admin123demo

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
